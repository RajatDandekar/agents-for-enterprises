  "intent": [
   {
    "type": "function",
    "function": {
     "name": "find_item",
     "description": "Find stock items by description or code (e.g. '5 litre silicone gasket'). Returns active items, best match first, with their code, unit and whether they touch food.",
     "parameters": {
      "type": "object",
      "properties": {
       "query": {
        "type": "string",
        "description": "words describing the item, or its code"
       }
      },
      "required": [
       "query"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "stock_position",
     "description": "Stock on hand, on order and days of cover for an item, in every warehouse.",
     "parameters": {
      "type": "object",
      "properties": {
       "item_code": {
        "type": "string",
        "description": "Bahi item code, e.g. GSK-SIL-05L"
       }
      },
      "required": [
       "item_code"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "last_purchase",
     "description": "Recent released orders for an item (supplier, quantity, rate, date) and each supplier's CURRENT contract rate. Use the contract rate for a new order, not an old order's rate.",
     "parameters": {
      "type": "object",
      "properties": {
       "item_code": {
        "type": "string"
       },
       "supplier_code": {
        "type": "string",
        "description": "optional, to see one supplier only"
       }
      },
      "required": [
       "item_code"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "find_supplier",
     "description": "Look a supplier up by name, tolerating different spellings. Returns the closest matches with their status and food-grade certificate. ALWAYS use this before registering a supplier.",
     "parameters": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string",
        "description": "supplier name as the user said it"
       },
       "city": {
        "type": "string",
        "description": "optional"
       }
      },
      "required": [
       "name"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "check_cost_centre",
     "description": "Is a cost centre open, and how much budget is left this quarter? Without a code, lists every open cost centre.",
     "parameters": {
      "type": "object",
      "properties": {
       "code": {
        "type": "string",
        "description": "e.g. PRD-07; omit to list open ones"
       }
      },
      "required": []
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "create_purchase_order",
     "description": "Order an item from a supplier. With confirm=false (the default) it only PREVIEWS: price, tax, gross value, whether approval is needed and who approves. Show the preview to the user; call again with confirm=true to commit. Above ₹50,000 it raises the purchase request first; if that needs approval it returns WAITING FOR APPROVAL and you call again with the same arguments once approved. Returns a receipt with the real status.",
     "parameters": {
      "type": "object",
      "properties": {
       "supplier_code": {
        "type": "string"
       },
       "item_code": {
        "type": "string"
       },
       "quantity": {
        "type": "integer"
       },
       "cost_centre": {
        "type": "string"
       },
       "need_by": {
        "type": "string",
        "description": "date, YYYY-MM-DD"
       },
       "rate": {
        "type": "number",
        "description": "omit to use the current contract rate"
       },
       "idempotency_key": {
        "type": "string",
        "description": "optional; reuse it on retries. Omit it and the tool derives one from the order's content"
       },
       "confirm": {
        "type": "boolean",
        "description": "false = preview only; true = commit"
       }
      },
      "required": [
       "supplier_code",
       "item_code",
       "quantity",
       "cost_centre",
       "need_by"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "release_purchase_order",
     "description": "Release an APPROVED order to the supplier. Returns a receipt with the real status.",
     "parameters": {
      "type": "object",
      "properties": {
       "po_no": {
        "type": "string"
       }
      },
      "required": [

{
  "name": "working_days",
  "title": "Working days",
  "category": "HR",
  "writes": false,
  "version": "1.0",
  "description": "Count the working days between two dates (inclusive) at the employee's plant: Sundays and plant holidays are not counted. Use it to turn 'Thursday and Friday' into dates and days before applying.",
  "services": [
    "lv_hol_list"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "from_date": {
        "type": "string",
        "description": "YYYY-MM-DD"
      },
      "to_date": {
        "type": "string",
        "description": "YYYY-MM-DD"
      }
    },
    "required": [
      "from_date",
      "to_date"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "days": {
        "type": "number"
      },
      "dates": {
        "type": "array"
      },
      "holidays": {
        "type": "array"
      }
    }
  },
  "example": {
    "from_date": "2026-10-29",
    "to_date": "2026-10-30"
  }
}

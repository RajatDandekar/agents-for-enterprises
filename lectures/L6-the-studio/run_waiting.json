{
 "workflow": {
  "id": "diwali-gasket-order",
  "name": "Diwali gasket order",
  "nodes": [
   {
    "id": "start",
    "type": "trigger",
    "config": {
     "kind": "manual"
    }
   },
   {
    "id": "stock",
    "type": "tool",
    "config": {
     "tool": "check_stock",
     "as": "KJOSHI",
     "args": {
      "item_code": "GSK-SIL-05L"
     }
    }
   },
   {
    "id": "pr",
    "type": "tool",
    "config": {
     "tool": "create_purchase_request",
     "as": "KJOSHI",
     "confirm": true,
     "args": {
      "item_code": "{{nodes.stock.item_code}}",
      "quantity": 20000,
      "cost_centre": "PRD-07",
      "need_by": "2026-11-09"
     }
    }
   },
   {
    "id": "rohit",
    "type": "approval",
    "config": {
     "doc_no": "{{nodes.pr.request_no}}",
     "approver": "RMEHTA"
    }
   },
   {
    "id": "po",
    "type": "tool",
    "config": {
     "tool": "create_purchase_order",
     "as": "KJOSHI",
     "confirm": true,
     "args": {
      "supplier_code": "DP-RJK-0042",
      "request_no": "{{nodes.pr.request_no}}"
     }
    }
   },
   {
    "id": "release",
    "type": "tool",
    "config": {
     "tool": "release_purchase_order",
     "as": "KJOSHI",
     "args": {
      "po_no": "{{nodes.po.po_no}}"
     }
    }
   },
   {
    "id": "tell",
    "type": "message",
    "config": {
     "to": "@rohit",
     "as": "KJOSHI",
     "text": "{{nodes.release.po_no}} released to Deccan Polymers: {{nodes.po.gross_value}} gross. Thanks for approving {{nodes.pr.request_no}}."
    }
   }
  ],
  "edges": [
   {
    "from": "start",
    "to": "stock"
   },
   {
    "from": "stock",
    "to": "pr"
   },
   {
    "from": "pr",
    "to": "rohit"
   },
   {
    "from": "rohit",
    "to": "po"
   },
   {
    "from": "po",
    "to": "release"
   },
   {
    "from": "release",
    "to": "tell"
   }
  ]
 },

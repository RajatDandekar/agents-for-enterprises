"cues": [
{
"block": "b1",
"t": 3.2,
"end": 6.451,
"text": "RAG goes back to the raw documents for every question."
},
{
"block": "b1",
"t": 6.985,
"end": 16.76,
"text": "Andrej Karpathy proposed another way, an LLM Wiki: the model reads every source once, and writes what it learns into a wiki it keeps up to date."
},
{
"block": "b2",
"t": 17.36,
"end": 32.035,
"text": "Three layers: the raw sources, 693 files, never edited; the wiki, markdown pages the model owns; and the schema, AGENTS.md, the rules for every page."
},
{
"block": "b3",
"t": 32.635,
"end": 33.679,
"text": "First, ingest."
},
{
"block": "b3",
"t": 34.179,
"end": 46.95,
"text": "The model reads the sources in 1,067 parts, takes out each fact with its quote and location, and writes it onto a page: one per supplier, policy, error code or screen."
},
{
"block": "b3",
"t": 47.484,
"end": 55.901,
"text": "683 pages, 4,035 links, and a line in log.md for each ingest."
},
{
"block": "b4",
"t": 56.501,
"end": 65.568,
"text": "Each page is shaped like a Wikipedia article: a lead, an infobox, sections, links, and references to the exact source."
},
{
"block": "b4",
"t": 66.068,
"end": 75.03,
"text": "Brightcell Energy: a prospective supplier in Lyon, not in the supplier master, its UN 38.3 report due in December."
},
{
"block": "b5",
"t": 75.63,
"end": 79.159,
"text": "Emma asks: can I buy the battery packs from Brightcell?"
},
{
"block": "b5",
"t": 79.775,
"end": 81.69,
"text": "They quote \u00a3104."
},
{
"block": "b5",
"t": 82.224,
"end": 93.091,
"text": "The model reads index.md, the table of contents, and opens three pages: Brightcell, the Supplier Policy, and the procedure for quotations."
},
{
"block": "b6",
"t": 93.691,
"end": 96.093,
"text": "The answer: no, not today."
},
{
"block": "b6",
"t": 96.593,
"end": 106.403,
"text": "Brightcell is not in the supplier master, and battery suppliers need a valid UN 38.3 certificate; price alone never decides."
},
{
"block": "b6",
"t": 106.903,
"end": 112.777,
"text": "Each claim cites a page, and the pages cite 33 places in the sources."
},
{
"block": "b7",
"t": 113.377,
"end": 115.315,
"text": "A good answer is not thrown away."
},
{
"block": "b7",
"t": 115.815,
"end": 123.78,
"text": "It is filed back as a new page with 16 references, so the next person who asks finds it in one step."
},
{
"block": "b8",
"t": 124.38,
"end": 135.944,
"text": "When a new document arrives, only the pages it touches change: patch note P6 updated four pages and created three, in 40 seconds, for 15 cents."
},
{
"block": "b9",
"t": 136.544,
"end": 141.791,
"text": "And lint checks the whole wiki for superseded copies, contradictions and broken links."
},
{
"block": "b9",
"t": 142.291,
"end": 145.739,
"text": "It found 31 of the 40 problems we planted."
},
{
"block": "b10",
"t": 146.339,
"end": 148.823,
"text": "RAG reads the raw pile at every question."
},
{
"block": "b10",
"t": 149.323,
"end": 153.282,
"text": "The wiki reads it once, and keeps what it learned as linked pages."
},
{
"block": "b10",
"t": 153.816,
"end": 157.113,
"text": "Which should Ask Northbridge use? We race them."
}
]
}
"cues": [
{
"block": "b1",
"t": 3.2,
"end": 4.407,
"text": "Two ways to remember."
},
{
"block": "b1",
"t": 4.907,
"end": 15.646,
"text": "Now we race them: the same 224 questions, the same model, the same judge, and the same 250-word limit on every answer."
},
{
"block": "b2",
"t": 16.246,
"end": 19.635,
"text": "Four lanes: RAG, with keywords and a reranker."
},
{
"block": "b2",
"t": 20.135,
"end": 23.234,
"text": "The wiki, navigating from index.md."
},
{
"block": "b2",
"t": 23.734,
"end": 26.764,
"text": "A hybrid that searches the wiki's sections, then navigates."
},
{
"block": "b2",
"t": 27.264,
"end": 28.262,
"text": "And sections alone."
},
{
"block": "b2",
"t": 28.762,
"end": 33.661,
"text": "Pasting everything is out: 4.7 million tokens fit no model."
},
{
"block": "b3",
"t": 34.261,
"end": 36.826,
"text": "First, Emma's error code. Go."
},
{
"block": "b3",
"t": 37.326,
"end": 42.689,
"text": "RAG has its chunks in 43 milliseconds, and its answer in 9.2 seconds."
},
{
"block": "b3",
"t": 43.189,
"end": 48.018,
"text": "Sections alone finish in 9.1, but miss VAT20-RC."
},
{
"block": "b3",
"t": 48.518,
"end": 50.584,
"text": "The hybrid takes 13.3."
},
{
"block": "b3",
"t": 51.084,
"end": 55.67,
"text": "The wiki navigates for six seconds, and answers in 15.7."
},
{
"block": "b4",
"t": 56.27,
"end": 57.767,
"text": "Now Brightcell. Go."
},
{
"block": "b4",
"t": 58.267,
"end": 62.319,
"text": "All four answer no, and the judge marks all four incomplete."
},
{
"block": "b4",
"t": 62.934,
"end": 68.193,
"text": "RAG misses the two prices and the switch PUR.CERT_CHK."
},
{
"block": "b4",
"t": 68.693,
"end": 70.666,
"text": "The wiki misses six facts."
},
{
"block": "b5",
"t": 71.266,
"end": 78.081,
"text": "Across all 224 questions, the hybrid is the most accurate: 92.9 percent."
},
{
"block": "b5",
"t": 78.696,
"end": 85.755,
"text": "RAG and the wiki tie at 89.3. Sections alone: 79.5."
},
{
"block": "b6",
"t": 86.355,
"end": 90.603,
"text": "But watch the clock. RAG's search takes 48 milliseconds."
},
{
"block": "b6",
"t": 91.103,
"end": 96.42,
"text": "The wiki must navigate first: 23 seconds at the slow end, the hybrid 11."
},
{
"block": "b6",
"t": 96.92,
"end": 103.538,
"text": "To a full answer, RAG needs 6.2 seconds; the wiki and the hybrid, about 12.5."
},
{
"block": "b7",
"t": 104.138,
"end": 107.609,
"text": "And the cost: RAG, under half a cent a question."
},
{
"block": "b7",
"t": 108.109,
"end": 112.404,
"text": "The hybrid, 2.4 cents; navigation, 3.2."
},
{
"block": "b7",
"t": 112.938,
"end": 121.785,
"text": "When a document changes, RAG re-indexes with no model at all; the wiki rewrites seven pages, for 15 cents."
},
{
"block": "b8",
"t": 122.385,
"end": 125.972,
"text": "By question type, the wiki wins on procedures and tables."
},
{
"block": "b8",
"t": 126.472,
"end": 128.144,
"text": "RAG wins on permissions."
},
{
"block": "b8",
"t": 128.759,
"end": 135.342,
"text": "Questions that join many documents stay hard for every method: 71 percent at best."
},
{
"block": "b9",
"t": 135.942,
"end": 143.441,
"text": "So Ask Northbridge uses RAG: inside the latency budget, nearly as accurate, at a fifth of the cost."
},
{
"block": "b9",
"t": 143.941,
"end": 148.574,
"text": "The hybrid wiki stays as a measured fallback for when RAG finds nothing."
}
]
}
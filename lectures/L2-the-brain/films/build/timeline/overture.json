"cues": [
{
"block": "b1",
"t": 3.2,
"end": 4.094,
"text": "One question."
},
{
"block": "b1",
"t": 4.57,
"end": 8.819,
"text": "How many city e-bike battery packs do we have in Manchester stores?"
},
{
"block": "b2",
"t": 9.569,
"end": 11.357,
"text": "One hundred tokens go in."
},
{
"block": "b2",
"t": 11.717,
"end": 15.211,
"text": "Twenty-four blocks of a real language model turn them over."
},
{
"block": "b2",
"t": 15.687,
"end": 22.944,
"text": "At every step, one token is chosen from 151,936."
},
{
"block": "b3",
"t": 23.694,
"end": 27.467,
"text": "And out comes a confident answer: 100."
},
{
"block": "b3",
"t": 27.874,
"end": 31.159,
"text": "The truth is 5,400."
},
{
"block": "b3",
"t": 31.809,
"end": 36.836,
"text": "Today we open the machine, and find out where that number came from."
}
]
}
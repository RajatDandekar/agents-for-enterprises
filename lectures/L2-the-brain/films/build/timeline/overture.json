"cues": [
{
"block": "b1",
"t": 3.2,
"end": 4.094,
"text": "One question."
},
{
"block": "b1",
"t": 4.57,
"end": 8.819,
"text": "How many city e-bike battery packs do we have in Manchester stores?"
},
{
"block": "b2",
"t": 9.569,
"end": 11.299,
"text": "One hundred tokens go in."
},
{
"block": "b2",
"t": 11.705,
"end": 23.919,
"text": "Twenty-four blocks of a real language model read them all, in one pass, and at the end one token is chosen, from 151,936."
},
{
"block": "b2",
"t": 24.325,
"end": 27.541,
"text": "Then the pass runs again, for the next token."
},
{
"block": "b3",
"t": 28.291,
"end": 32.064,
"text": "And out comes a confident answer: 100."
},
{
"block": "b3",
"t": 32.471,
"end": 35.756,
"text": "The truth is 5,400."
},
{
"block": "b3",
"t": 36.406,
"end": 41.433,
"text": "Today we open the machine, and find out where that number came from."
}
]
}
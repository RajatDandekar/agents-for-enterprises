"cues": [
{
"block": "b1",
"t": 3.2,
"end": 6.056,
"text": "Here is the whole machine, on one question."
},
{
"block": "b1",
"t": 6.613,
"end": 12.534,
"text": "Emma asks: how many city e-bike battery packs do we have in Manchester stores?"
},
{
"block": "b2",
"t": 13.284,
"end": 15.989,
"text": "First, her chat is cut into tokens."
},
{
"block": "b2",
"t": 16.395,
"end": 19.472,
"text": "One hundred tiles, each with its own number."
},
{
"block": "b2",
"t": 20.122,
"end": 22.711,
"text": "Manchester is a single tile."
},
{
"block": "b3",
"t": 23.461,
"end": 30.752,
"text": "Each tile looks up its vector: a column of 896 numbers, learned in training."
},
{
"block": "b4",
"t": 31.502,
"end": 32.802,
"text": "Then attention."
},
{
"block": "b4",
"t": 33.278,
"end": 38.631,
"text": "The last position sends out a query, and every key answers."
},
{
"block": "b4",
"t": 38.932,
"end": 45.527,
"text": "In block 24, head 2, 65 percent of the weight lands on Manchester."
},
{
"block": "b5",
"t": 46.277,
"end": 49.725,
"text": "Attention and a small network make one block."
},
{
"block": "b5",
"t": 50.375,
"end": 57.283,
"text": "The column climbs all 24, in one pass, and near the top, an answer starts to form."
},
{
"block": "b6",
"t": 58.033,
"end": 64.894,
"text": "At the top, it is scored against all 151,936 tokens."
},
{
"block": "b6",
"t": 65.359,
"end": 68.296,
"text": "Softmax turns the scores into probabilities."
},
{
"block": "b6",
"t": 68.656,
"end": 70.758,
"text": "We: 56 percent."
},
{
"block": "b6",
"t": 71.106,
"end": 72.29,
"text": "As: 8."
},
{
"block": "b6",
"t": 72.754,
"end": 74.844,
"text": "Manchester: 6."
},
{
"block": "b7",
"t": 75.594,
"end": 77.335,
"text": "One token is chosen."
},
{
"block": "b7",
"t": 77.812,
"end": 81.364,
"text": "It joins the strip, and the whole pass runs again."
},
{
"block": "b7",
"t": 81.62,
"end": 83.628,
"text": "One token at a time."
},
{
"block": "b8",
"t": 84.378,
"end": 85.609,
"text": "Then the number."
},
{
"block": "b8",
"t": 85.911,
"end": 87.745,
"text": "One, at 34 percent."
},
{
"block": "b8",
"t": 88.151,
"end": 88.813,
"text": "Zero."
},
{
"block": "b8",
"t": 89.115,
"end": 89.8,
"text": "Zero."
},
{
"block": "b8",
"t": 90.102,
"end": 92.075,
"text": "A confident 100."
},
{
"block": "b8",
"t": 92.633,
"end": 96.685,
"text": "Ledgerline says 5,400."
},
{
"block": "b9",
"t": 97.435,
"end": 101.452,
"text": "Nothing in the prompt carried the stock, so the model made a number up."
},
{
"block": "b9",
"t": 102.009,
"end": 107.245,
"text": "Put the stock line into the prompt, and the same model answers 5,400."
},
{
"block": "b9",
"t": 107.721,
"end": 109.834,
"text": "That is where we go next."
}
]
}
"cues": [
{
"block": "b1",
"t": 3.2,
"end": 5.336,
"text": "Last section, text went in."
},
{
"block": "b1",
"t": 5.743,
"end": 7.531,
"text": "But a model never sees letters."
},
{
"block": "b1",
"t": 7.937,
"end": 12.488,
"text": "It sees tokens: pieces of text, each with a number."
},
{
"block": "b2",
"t": 13.238,
"end": 16.048,
"text": "Emma's chat is cut into 100 tiles."
},
{
"block": "b2",
"t": 16.605,
"end": 25.87,
"text": "72 for the app's instructions, 15 for her question, and 13 for the markers that say who is speaking."
},
{
"block": "b3",
"t": 26.62,
"end": 28.733,
"text": "Common words are one tile each."
},
{
"block": "b3",
"t": 29.105,
"end": 33.052,
"text": "Manchester is one token, number 19361."
},
{
"block": "b3",
"t": 33.551,
"end": 36.488,
"text": "Northbridge is two: North, bridge."
},
{
"block": "b3",
"t": 36.767,
"end": 38.857,
"text": "And a number is cut digit by digit."
},
{
"block": "b3",
"t": 39.217,
"end": 46.589,
"text": "5,400 becomes five tokens: five, comma, four, zero, zero."
},
{
"block": "b4",
"t": 47.339,
"end": 48.976,
"text": "Where do the pieces come from?"
},
{
"block": "b4",
"t": 49.522,
"end": 51.054,
"text": "From byte pair encoding."
},
{
"block": "b4",
"t": 51.6,
"end": 57.997,
"text": "Start with single bytes, then keep merging the pair that appears most often in a huge pile of text."
},
{
"block": "b4",
"t": 58.624,
"end": 65.637,
"text": "Qwen's tokenizer learned 151,643 pieces this way."
},
{
"block": "b5",
"t": 66.387,
"end": 77.405,
"text": "Add 22 special tokens, like the markers in Emma's chat, and the tokenizer knows 151,665 pieces."
},
{
"block": "b5",
"t": 77.811,
"end": 81.155,
"text": "The model keeps one row in its table for each."
},
{
"block": "b6",
"t": 81.905,
"end": 84.308,
"text": "So: 100 tokens in."
},
{
"block": "b6",
"t": 84.784,
"end": 89.382,
"text": "That is what Emma's question costs, and exactly what the model reads."
}
]
}
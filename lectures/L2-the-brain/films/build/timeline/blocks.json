"cues": [
{
"block": "b1",
"t": 3.2,
"end": 6.996,
"text": "Emma's chat is now a row of 100 tokens."
},
{
"block": "b1",
"t": 7.554,
"end": 11.164,
"text": "First the app's instructions, then her question."
},
{
"block": "b1",
"t": 11.815,
"end": 17.086,
"text": "How many city e-bike battery packs do we have in Manchester stores?"
},
{
"block": "b2",
"t": 17.836,
"end": 22.039,
"text": "Each token is now a column of 896 numbers."
},
{
"block": "b2",
"t": 22.294,
"end": 24.848,
"text": "A hundred columns, side by side."
},
{
"block": "b2",
"t": 25.255,
"end": 27.681,
"text": "This is what goes into the model."
},
{
"block": "b3",
"t": 28.431,
"end": 34.213,
"text": "Above them stands the stack: 24 blocks, all built the same way."
},
{
"block": "b3",
"t": 34.689,
"end": 36.558,
"text": "Let's open the first one."
},
{
"block": "b4",
"t": 37.558,
"end": 40.275,
"text": "First, attention, with 14 heads."
},
{
"block": "b4",
"t": 40.635,
"end": 44.872,
"text": "Every position reads the positions before it, and mixes in what it needs."
},
{
"block": "b4",
"t": 45.232,
"end": 48.437,
"text": "Battery can read city and e-bike, but never packs."
},
{
"block": "b4",
"t": 48.738,
"end": 50.596,
"text": "Manchester can read battery."
},
{
"block": "b4",
"t": 50.852,
"end": 54.788,
"text": "And the last position can read all 99 before it."
},
{
"block": "b5",
"t": 55.538,
"end": 57.117,
"text": "Then the MLP."
},
{
"block": "b5",
"t": 57.593,
"end": 68.669,
"text": "It takes each column on its own, widens it from 896 numbers to 4,864, and squeezes it back to 896."
},
{
"block": "b5",
"t": 68.971,
"end": 71.885,
"text": "Here, no column sees any other."
},
{
"block": "b6",
"t": 72.885,
"end": 77.297,
"text": "Out come 100 columns, and every one of them has changed."
},
{
"block": "b6",
"t": 77.599,
"end": 82.394,
"text": "Then all 100 climb to the next block, and it happens again."
},
{
"block": "b6",
"t": 82.753,
"end": 83.531,
"text": "And again."
},
{
"block": "b6",
"t": 83.938,
"end": 86.956,
"text": "All the way through block 24."
},
{
"block": "b7",
"t": 90.156,
"end": 94.835,
"text": "At the top, the model reads out just one column: the last one."
},
{
"block": "b7",
"t": 95.241,
"end": 100.651,
"text": "Only its 896 numbers are turned into scores for the next token."
},
{
"block": "b8",
"t": 101.401,
"end": 104.245,
"text": "So why work on the other 99?"
},
{
"block": "b8",
"t": 104.803,
"end": 108.739,
"text": "Because in every block, the last position reads them."
},
{
"block": "b8",
"t": 109.145,
"end": 112.187,
"text": "That is how Emma's words reach the answer."
},
{
"block": "b8",
"t": 112.744,
"end": 118.618,
"text": "In block 24, one head puts 65 percent of its weight on Manchester."
},
{
"block": "b8",
"t": 119.024,
"end": 122.24,
"text": "In block 19, another reads stores."
},
{
"block": "b8",
"t": 122.542,
"end": 125.781,
"text": "Without those columns, there would be nothing to read."
},
{
"block": "b9",
"t": 126.531,
"end": 128.18,
"text": "Can we watch the answer form?"
},
{
"block": "b9",
"t": 128.644,
"end": 133.613,
"text": "Ask the last column early, after each block: what would you say now?"
},
{
"block": "b9",
"t": 133.961,
"end": 136.225,
"text": "For 17 blocks, noise."
},
{
"block": "b9",
"t": 136.585,
"end": 139.348,
"text": "At block 18, a lowercase we."
},
{
"block": "b9",
"t": 139.755,
"end": 146.686,
"text": "From block 22, We leads: 8 percent, then 29, then 56."
},
{
"block": "b10",
"t": 147.686,
"end": 150.983,
"text": "Every block reads the row with 14 heads."
},
{
"block": "b10",
"t": 151.459,
"end": 154.42,
"text": "Next: what each of those heads looks for."
}
]
}
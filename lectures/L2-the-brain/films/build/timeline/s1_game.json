"cues": [
{
"block": "b1",
"t": 3.2,
"end": 6.091,
"text": "Here is the whole idea of a language model."
},
{
"block": "b1",
"t": 6.567,
"end": 10.677,
"text": "Text goes in, and the model predicts the next token."
},
{
"block": "b2",
"t": 11.427,
"end": 18.323,
"text": "It reads Emma's question, with the app's instructions in front: 100 tokens, in one pass."
},
{
"block": "b2",
"t": 18.881,
"end": 28.412,
"text": "At the end of that pass, it gives a probability to every entry in its vocabulary, all 151,936."
},
{
"block": "b2",
"t": 28.969,
"end": 31.582,
"text": "The top of the list looks like this."
},
{
"block": "b3",
"t": 32.332,
"end": 34.631,
"text": "We: 56 percent."
},
{
"block": "b3",
"t": 35.037,
"end": 36.337,
"text": "As: 8."
},
{
"block": "b3",
"t": 36.744,
"end": 38.427,
"text": "Manchester: 6."
},
{
"block": "b3",
"t": 38.985,
"end": 40.436,
"text": "In: 5."
},
{
"block": "b3",
"t": 40.993,
"end": 42.595,
"text": "The model is not certain."
},
{
"block": "b3",
"t": 43.002,
"end": 44.824,
"text": "It is placing bets."
},
{
"block": "b4",
"t": 45.574,
"end": 48.43,
"text": "One token is chosen and added to the text."
},
{
"block": "b4",
"t": 48.732,
"end": 52.621,
"text": "Then the whole pass runs again, once for every new token."
},
{
"block": "b4",
"t": 53.016,
"end": 56.255,
"text": "A few tokens later, the answer reaches its number."
},
{
"block": "b4",
"t": 56.65,
"end": 58.577,
"text": "Now the bets are on a digit."
},
{
"block": "b4",
"t": 58.972,
"end": 60.737,
"text": "One: 34 percent."
},
{
"block": "b4",
"t": 61.085,
"end": 62.711,
"text": "Two: 21."
},
{
"block": "b4",
"t": 63.071,
"end": 64.94,
"text": "Five: 12."
},
{
"block": "b5",
"t": 65.69,
"end": 67.652,
"text": "Nothing here looks anything up."
},
{
"block": "b5",
"t": 68.209,
"end": 72.76,
"text": "Every word of the answer, the number too, is a bet like this one."
},
{
"block": "b5",
"t": 73.411,
"end": 77.997,
"text": "The rest of the lecture opens the box, to see how the bets are made."
}
]

"cues": [
{
"block": "b1",
"t": 3.2,
"end": 7.414,
"text": "Here is the whole idea of a language model, as one game."
},
{
"block": "b1",
"t": 7.821,
"end": 9.179,
"text": "Text goes in."
},
{
"block": "b1",
"t": 9.539,
"end": 13.649,
"text": "Out comes a guess: which token comes next?"
},
{
"block": "b2",
"t": 14.399,
"end": 20.123,
"text": "We give it Emma's question, with the app's instructions in front: 100 tokens."
},
{
"block": "b2",
"t": 20.529,
"end": 25.069,
"text": "The model reads them all and gives a score to every token it knows."
},
{
"block": "b2",
"t": 25.475,
"end": 29.724,
"text": "Turned into probabilities, the top of the list looks like this."
},
{
"block": "b3",
"t": 30.474,
"end": 32.773,
"text": "We: 56 percent."
},
{
"block": "b3",
"t": 33.179,
"end": 34.479,
"text": "As: 8."
},
{
"block": "b3",
"t": 34.886,
"end": 36.569,
"text": "Manchester: 6."
},
{
"block": "b3",
"t": 37.127,
"end": 38.578,
"text": "In: 5."
},
{
"block": "b3",
"t": 39.135,
"end": 40.737,
"text": "The model is not certain."
},
{
"block": "b3",
"t": 41.144,
"end": 42.966,
"text": "It is placing bets."
},
{
"block": "b4",
"t": 43.716,
"end": 46.804,
"text": "Pick one, add it to the text, and play again."
},
{
"block": "b4",
"t": 47.454,
"end": 51.112,
"text": "A few tokens later, the answer reaches its number."
},
{
"block": "b4",
"t": 51.518,
"end": 53.515,
"text": "Now the bets are on a digit."
},
{
"block": "b4",
"t": 53.875,
"end": 55.79,
"text": "One: 34 percent."
},
{
"block": "b4",
"t": 56.197,
"end": 57.811,
"text": "Two: 21."
},
{
"block": "b4",
"t": 58.17,
"end": 60.156,
"text": "Five: 12."
},
{
"block": "b5",
"t": 60.906,
"end": 62.868,
"text": "Nothing here looks anything up."
},
{
"block": "b5",
"t": 63.425,
"end": 67.976,
"text": "Every word of the answer, the number too, is a bet like this one."
},
{
"block": "b5",
"t": 68.627,
"end": 73.213,
"text": "The rest of the lecture opens the box, to see how the bets are made."
}
]

"cues": [
{
"block": "b1",
"t": 3.2,
"end": 6.079,
"text": "One attention pattern can only look one way."
},
{
"block": "b1",
"t": 6.439,
"end": 12.906,
"text": "If it spends its weight on Manchester, little is left for battery, or for the word just before."
},
{
"block": "b2",
"t": 13.656,
"end": 15.572,
"text": "So the model splits the job."
},
{
"block": "b2",
"t": 16.129,
"end": 21.342,
"text": "The 896 numbers are cut into 14 heads of 64."
},
{
"block": "b2",
"t": 21.899,
"end": 28.099,
"text": "Each head asks its own question, and all 14 run at the same time."
},
{
"block": "b3",
"t": 29.099,
"end": 33.824,
"text": "To save memory, the heads share their keys and values."
},
{
"block": "b3",
"t": 34.126,
"end": 40.57,
"text": "Fourteen queries, two sets of keys and values: seven heads to each set."
},
{
"block": "b4",

"cues": [
{
"block": "b1",
"t": 3.2,
"end": 5.835,
"text": "Every column now knows only its own word."
},
{
"block": "b1",
"t": 6.195,
"end": 12.906,
"text": "Attention lets each position look back at the others, and take what it needs."
},
{
"block": "b2",
"t": 13.656,
"end": 20.912,
"text": "From the last position, this is where the model looks, averaged over all 14 heads and all 24 blocks."
},
{
"block": "b2",
"t": 21.319,
"end": 26.45,
"text": "Most of the weight goes to the chat's markers, the tokens that say who is speaking."
},
{
"block": "b2",
"t": 27.101,
"end": 29.957,
"text": "About a fifth goes to Emma's question."
},
{
"block": "b3",
"t": 30.707,
"end": 33.366,
"text": "But each head looks for something different."
},
{
"block": "b3",
"t": 33.772,
"end": 38.962,
"text": "Block 24, head 2, puts 65 percent on Manchester."
},
{
"block": "b3",
"t": 39.519,
"end": 45.719,
"text": "Block 16, head 0, is the head that looks hardest at battery: 9 percent."
},
{
"block": "b3",
"t": 46.125,
"end": 54.484,
"text": "And block 12, head 13, rests all of its weight on the very first token, when it has nothing to add."
},
{
"block": "b4",
"t": 55.234,
"end": 56.36,
"text": "There is one rule."
},
{
"block": "b4",
"t": 56.662,
"end": 59.866,
"text": "A position may look back, never forward."
},
{
"block": "b4",
"t": 60.424,
"end": 65.683,
"text": "Battery can see How many city e-bike, but not packs, or Manchester."
},
{
"block": "b4",
"t": 66.24,
"end": 72.045,
"text": "When the model writes, the future does not exist yet, so it is masked out in training too."
},
{
"block": "b5",
"t": 72.795,
"end": 77.102,
"text": "Fourteen heads, side by side, in each of 24 blocks."
},
{
"block": "b5",
"t": 77.509,
"end": 81.804,
"text": "Each one mixes what it found into the column, and passes it up."
}
]
}
"cues": [
{
"block": "b1",
"t": 3.2,
"end": 6.37,
"text": "Last section, Emma's question became tokens."
},
{
"block": "b1",
"t": 6.671,
"end": 11.513,
"text": "But token 19361 means nothing on its own."
},
{
"block": "b1",
"t": 12.163,
"end": 16.064,
"text": "So each token looks up its row in a table."
},
{
"block": "b2",
"t": 16.814,
"end": 21.133,
"text": "Each row is a vector: 896 numbers."
},
{
"block": "b2",
"t": 21.609,
"end": 22.816,
"text": "Here is battery."
},
{
"block": "b2",
"t": 23.118,
"end": 24.535,
"text": "Here is Manchester."
},
{
"block": "b2",
"t": 25.092,
"end": 29.306,
"text": "The model learned every one of these numbers in training."
},
{
"block": "b3",
"t": 30.056,
"end": 31.182,
"text": "Why so many?"
},
{
"block": "b3",
"t": 31.589,
"end": 35.373,
"text": "Because a vector is a position, in a space of meaning."
},
{
"block": "b3",
"t": 35.78,
"end": 39.216,
"text": "Words that are used alike end up close together."
},
{
"block": "b3",
"t": 39.866,
"end": 45.195,
"text": "Squash the 896 dimensions down to three, and you can see it."
},
{
"block": "b4",
"t": 45.945,
"end": 47.547,
"text": "The bike parts gather here."
},
{
"block": "b4",
"t": 47.907,
"end": 48.894,
"text": "The cities, there."
},
{
"block": "b4",
"t": 49.254,
"end": 51.843,
"text": "The days and months, over here."
},
{
"block": "b5",
"t": 52.593,
"end": 59.803,
"text": "Ask which words sit nearest to battery, and you get batteries, lithium, capacitor, charger."
},
{
"block": "b5",
"t": 60.453,
"end": 66.2,
"text": "Nearest to Manchester: Liverpool, Nottingham, Leicester, Leeds."
},
{
"block": "b6",
"t": 66.95,
"end": 74.334,
"text": "So the strip of tiles is now a row of 100 columns, each one a point in meaning."
},
{
"block": "b6",
"t": 74.891,
"end": 78.003,
"text": "Next, those columns start to talk to each other."
}
]
}
"cues": [
{
"block": "b1",
"t": 3.2,
"end": 8.692,
"text": "This is the model we have been opening: 24 blocks, one on top of another."
},
{
"block": "b1",
"t": 9.249,
"end": 11.408,
"text": "Every block is full of numbers."
},
{
"block": "b1",
"t": 11.815,
"end": 13.37,
"text": "Let's count them."
},
{
"block": "b2",
"t": 14.12,
"end": 17.87,
"text": "Lift out the top block, and lay out what is inside."
},
{
"block": "b2",
"t": 18.52,
"end": 23.733,
"text": "Each glass sheet is one weight matrix, at its real shape."
},
{
"block": "b3",
"t": 24.483,
"end": 25.656,
"text": "Attention first."
},
{
"block": "b3",
"t": 26.132,
"end": 31.252,
"text": "The query and output matrices are 896 by 896."
},
{
"block": "b3",
"t": 31.809,
"end": 39.483,
"text": "Keys and values are thin, 896 by 128, because the fourteen heads share them."
},
{
"block": "b4",
"t": 40.233,
"end": 47.187,
"text": "Then the feed-forward part: gate, up and down, each 896 by 4,864."
},
{
"block": "b4",
"t": 47.663,
"end": 49.161,
"text": "They hold most of the block."
},
{
"block": "b4",
"t": 49.718,
"end": 53.375,
"text": "One block: almost 15 million numbers."
},
{
"block": "b5",
"t": 54.125,
"end": 57.991,
"text": "Times 24 blocks: 358 million."
},
{
"block": "b5",
"t": 58.397,
"end": 65.131,
"text": "Add the embedding table, a row for every token in the vocabulary: 136 million more."
},
{
"block": "b5",
"t": 65.387,
"end": 68.847,
"text": "In all, 494 million numbers."
},
{
"block": "b6",
"t": 69.597,
"end": 70.375,
"text": "Look closer."
},
{
"block": "b6",
"t": 70.851,
"end": 72.906,
"text": "Every cell is one number."
},
{
"block": "b6",
"t": 73.382,
"end": 84.272,
"text": "The corner of block 24's query matrix: \u22120.0031, \u22120.0076, 0.0104."
},
{
"block": "b7",
"t": 85.022,
"end": 87.298,
"text": "Every answer came from these numbers."
},
{
"block": "b7",
"t": 87.657,
"end": 88.877,
"text": "Who chose them?"
}
]
}
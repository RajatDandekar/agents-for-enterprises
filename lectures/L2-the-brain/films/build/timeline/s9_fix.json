"cues": [
{
"block": "b1",
"t": 3.2,
"end": 6.068,
"text": "So why did the model say 100?"
},
{
"block": "b1",
"t": 6.428,
"end": 8.053,
"text": "Trace the first digit back."
},
{
"block": "b1",
"t": 8.459,
"end": 13.603,
"text": "When it wrote the one, it was looking back over 104 tokens."
},
{
"block": "b2",
"t": 14.353,
"end": 20.738,
"text": "The only digits among them are the date: 26 October 2026."
},
{
"block": "b2",
"t": 21.389,
"end": 24.639,
"text": "Nothing in the input carried Northbridge's stock."
},
{
"block": "b2",
"t": 25.29,
"end": 27.623,
"text": "So the model did what it was trained to do."
},
{
"block": "b2",
"t": 27.983,
"end": 30.328,
"text": "It wrote a plausible number."
},
{
"block": "b3",
"t": 31.078,
"end": 34.747,
"text": "Now add one line to the prompt, straight from Ledgerline."
},
{
"block": "b3",
"t": 35.304,
"end": 41.341,
"text": "BAT-500 at Manchester main stores: 5,400 on hand."
},
{
"block": "b4",
"t": 42.091,
"end": 44.146,
"text": "Same model, same question."
},
{
"block": "b4",
"t": 44.622,
"end": 48.291,
"text": "This time the answer is 5,400."
},
{
"block": "b4",
"t": 48.848,
"end": 57.509,
"text": "As it writes the five, block 10, head 13, puts 77 percent of its weight on the five tokens of that number."
},
{
"block": "b5",
"t": 58.259,
"end": 60.198,
"text": "The fix is not a bigger brain."
},
{
"block": "b5",
"t": 60.337,
"end": 62.543,
"text": "It is the right facts, in front of it."
},
{
"block": "b5",
"t": 63.019,
"end": 65.643,
"text": "Lecture 3 gives the model knowledge."
},
{
"block": "b5",
"t": 65.898,
"end": 68.197,
"text": "Lecture 4 gives it tools."
}
]

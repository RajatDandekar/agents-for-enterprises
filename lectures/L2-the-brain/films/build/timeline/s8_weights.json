"cues": [
{
"block": "b1",
"t": 3.2,
"end": 8.912,
"text": "Every bet came from the weights: 494 million numbers inside the model."
},
{
"block": "b1",
"t": 9.272,
"end": 11.141,
"text": "Where did they come from?"
},
{
"block": "b2",
"t": 11.891,
"end": 14.016,
"text": "At the start, they are random."
},
{
"block": "b2",
"t": 14.376,
"end": 19.287,
"text": "Our tiny GPT, trained on Northbridge's own documents, shows it."
},
{
"block": "b2",
"t": 19.693,
"end": 23.408,
"text": "Before training, it writes noise."
},
{
"block": "b3",
"t": 24.158,
"end": 32.041,
"text": "Training is the same game, played over and over: guess the next character, measure the error, nudge every weight a little."
},
{
"block": "b3",
"t": 32.448,
"end": 38.787,
"text": "The loss falls from 4.6 to 0.23 in 1,500 steps."
},
{
"block": "b4",
"t": 39.537,
"end": 42.916,
"text": "Afterwards it writes perfect Northbridge stock lines."
},
{
"block": "b4",
"t": 43.322,
"end": 48.372,
"text": "BAT-500 in Manchester stores: 2,400 on hand."
},
{
"block": "b4",
"t": 48.674,
"end": 50.543,
"text": "Well formed, and invented."
},
{
"block": "b4",
"t": 51.101,
"end": 57.416,
"text": "The real figure, 5,400, was in its training text three times."
},
{
"block": "b5",
"t": 58.166,
"end": 67.918,
"text": "Qwen went through the same steps at vast scale: up to 18 trillion tokens of pretraining, over a million instruction examples, then preference tuning."
},
{
"block": "b5",
"t": 68.569,
"end": 74.258,
"text": "Its weights were frozen at its release, on 19 September 2024."
},
{
"block": "b5",
"t": 74.734,
"end": 78.739,
"text": "Emma asked on 26 October 2026."
}
]

{
  "mcpServers": {
    "rasoi-toolbox": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "bahi.course.protocols.rasoi_mcp", "--user", "KJOSHI"]
    },
    "rasoi-toolbox-http": {
      "url": "http://127.0.0.1:8765/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PAT}"
      }
    }
  }
}

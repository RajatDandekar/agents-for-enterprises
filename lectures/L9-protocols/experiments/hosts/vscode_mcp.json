{
  "inputs": [
    {
      "type": "promptString",
      "id": "github_pat",
      "description": "GitHub personal access token (only for the github-pat entry)",
      "password": true
    }
  ],
  "servers": {
    "rasoi-toolbox": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "bahi.course.protocols.rasoi_mcp", "--user", "KJOSHI"]
    },
    "rasoi-toolbox-http": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "github-pat": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:github_pat}"
      }
    }
  }
}

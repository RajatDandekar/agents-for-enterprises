       },
       "name": "approve_purchase_order",
       "title": "Approve purchase order"
      },
      {
       "annotations": {
        "readOnlyHint": false
       },
       "description": "Release an APPROVED purchase order to the supplier; only then does the supplier get it. Returns a receipt with the real status.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "po_no": {
          "type": "string",
          "description": "e.g. PO/2026/01182"
         }
        },
        "required": [
         "po_no"
        ]
       },
       "name": "release_purchase_order",
       "title": "Release purchase order"
      },
      {
       "annotations": {
        "readOnlyHint": true
       },
       "description": "The real status of a purchase order or a purchase request, read from Bahi, with approval, goods received and any warning.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "po_no": {
          "type": "string",
          "description": "e.g. PO/2026/01182"
         },
         "request_no": {
          "type": "string",
          "description": "e.g. PR/2026/04417"
         }
        },
        "required": []
       },
       "name": "order_status",
       "title": "Order status"
      },

        },
        "required": [
         "item_code"
        ]
       },
       "name": "check_stock",
       "title": "Check stock"
      },
      {
       "annotations": {
        "readOnlyHint": true
       },
       "description": "Look a supplier up by name, tolerating different spellings. Returns the closest matches with code, city, status and whether they hold a valid food-grade certificate. Use it before registering anyone new.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string",
          "description": "the supplier's name as the user said it"
         },
         "city": {
          "type": "string",
          "description": "optional city, to tell two branches apart"
         }
        },
        "required": [
         "name"
        ]
       },
       "name": "find_supplier",
       "title": "Find supplier"
      },
      {
       "annotations": {
        "readOnlyHint": true
       },
       "description": "Is a cost centre open, and how much budget is left this quarter? Without a code, lists every open cost centre.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "cost_centre": {
          "type": "string",
          "description": "cost centre code, e.g. PRD-07; leave out to list the open ones"
         }
        },
        "required": []
       },
       "name": "check_budget",
       "title": "Check budget"
      },
      {
       "annotations": {
        "readOnlyHint": true
       },
       "description": "Search Rasoi's purchasing policy and the Bahi manual. Returns the relevant clauses with their citations, or says the documents do not cover it.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "question": {
          "type": "string",
          "description": "the policy question in plain words"
         }
        },
        "required": [
         "question"
        ]
       },
       "name": "search_policy",
       "title": "Search policy"
      },
      {
       "annotations": {
        "readOnlyHint": false
       },
       "description": "Raise a purchase request (PR): the internal ask to buy something. With confirm=false it previews the estimated value and who must approve; with confirm=true it saves and submits it. Within your limit it is approved at once; above it, it waits for your manager.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "item_code": {
          "type": "string",
          "description": "Bahi item code"
         },
         "quantity": {
          "type": "integer",
          "description": "how many, in the item's unit"
         },
         "cost_centre": {
          "type": "string",
          "description": "who pays, e.g. PRD-07"
         },
         "need_by": {
          "type": "string",
          "description": "date needed, YYYY-MM-DD"
         },
         "confirm": {
          "type": "boolean",
          "description": "false (default) = preview only, nothing is saved; true = commit"
         }
        },
        "required": [
         "item_code",
         "quantity",
         "cost_centre",
         "need_by"
        ]
       },
       "name": "create_purchase_request",
       "title": "Create purchase request"
      },
      {
       "annotations": {
        "readOnlyHint": true
       },
       "description": "What is waiting for the signed-in user's signature: purchase requests and orders, with value and who raised them.",
       "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
       },
       "name": "list_my_approvals",
       "title": "List my approvals"
      },
      {
       "annotations": {
        "readOnlyHint": false
       },
       "description": "Approve or reject a purchase request that waits for the signed-in user. Only the named approver can do this, never the person who raised it.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "request_no": {
          "type": "string",
          "description": "e.g. PR/2026/04417"
         },
         "decision": {
          "type": "string",
          "enum": [
           "approve",
           "reject"
          ],
          "description": "approve or reject"
         },
         "comment": {
          "type": "string",
          "description": "optional note to the requester"
         }
        },
        "required": [
         "request_no",
         "decision"
        ]
       },
       "name": "approve_purchase_request",
       "title": "Approve purchase request"
      },
      {
       "annotations": {
        "readOnlyHint": false
       },
       "description": "Create a purchase order (PO) with a supplier. Give request_no for an approved purchase request (it supplies item, quantity, cost centre and date), or item_code, quantity, cost_centre and need_by for a small direct order up to Rs 50,000. confirm=false previews price, tax and value; confirm=true saves it. Returns a receipt with the order's real status: an APPROVED order still has to be released.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "supplier_code": {
          "type": "string",
          "description": "Bahi supplier code, from find_supplier"
         },
         "request_no": {
          "type": "string",
          "description": "an APPROVED purchase request"
         },
         "item_code": {
          "type": "string",
          "description": "for a direct order"
         },
         "quantity": {
          "type": "integer",
          "description": "for a direct order"
         },
         "cost_centre": {
          "type": "string",
          "description": "for a direct order"
         },
         "need_by": {
          "type": "string",
          "description": "for a direct order, YYYY-MM-DD"
         },
         "rate": {
          "type": "number",
          "description": "omit to use the contract rate"
         },
         "confirm": {
          "type": "boolean",
          "description": "false (default) = preview only, nothing is saved; true = commit"
         }
        },
        "required": [
         "supplier_code"
        ]
       },
       "name": "create_purchase_order",
       "title": "Create purchase order"
      },
      {
       "annotations": {
        "readOnlyHint": false
       },
       "description": "Approve a purchase order that waits for the signed-in user's signature.",
       "inputSchema": {
        "type": "object",
        "properties": {

       },
       "description": "Stock of an item in every warehouse: on hand, allocated, on order, reorder level and days of cover.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "item_code": {
          "type": "string",
          "description": "Bahi item code, e.g. GSK-SIL-05L"

      {
       "annotations": {
        "readOnlyHint": true
       },
       "description": "Find stock items by description or code (e.g. '5 litre silicone gasket'). Returns active items, best match first, with code, unit and whether they touch food.",
       "inputSchema": {
        "type": "object",

{
  "name": "send_message",
  "title": "Send message",
  "category": "Messaging",
  "description": "Send a short message to a colleague or supplier (Slack handle like @daniel, or an email address). Goes through Ledgerline's notification queue.",
  "writes": true,
  "version": "1.0",
  "services": [
    "ntf_send"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "to": {
        "type": "string",
        "description": "@handle or email"
      },
      "text": {
        "type": "string",
        "description": "the message"
      }
    },
    "required": [
      "to",
      "text"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "queued": {
        "type": "boolean",
        "description": ""
      }
    }
  },
  "example": {
    "to": "@daniel",
    "text": "PR/2026/04417 needs your approval."
  }
}

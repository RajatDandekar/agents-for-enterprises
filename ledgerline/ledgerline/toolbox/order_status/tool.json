{
  "name": "order_status",
  "title": "Order status",
  "category": "Look up",
  "description": "The real status of a purchase order or a purchase request, read from Ledgerline, with approval, goods received and any warning.",
  "writes": false,
  "version": "1.0",
  "services": [
    "po_get",
    "grn_search",
    "pr_get"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "po_no": {
        "type": "string",
        "description": "e.g. PO/2026/01182"
      },
      "request_no": {
        "type": "string",
        "description": "e.g. PR/2026/04417"
      }
    },
    "required": []
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "status": {
        "type": "string",
        "description": ""
      },
      "received": {
        "type": "integer",
        "description": "quantity received so far (orders)"
      }
    }
  },
  "example": {
    "po_no": "PO/2026/01182"
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "policy": {
    "ledgerline_reply_timeout_s": 30,
    "on_busy_or_lost_reply": "retry the read, at most 2 more times",
    "after_retries": "ok=false, ledgerline_code ERR-SYS-0503 or TIMEOUT, with next_step"
  }
}

{
  "name": "list_invoices",
  "title": "List invoices",
  "category": "Accounts payable",
  "description": "Supplier invoices in accounts payable, filtered by status (received, matched, held, posted or all), supplier or order. Returns each invoice's match result and note, and counts by status.",
  "writes": false,
  "version": "1.0",
  "services": [
    "inv_search"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "received",
          "matched",
          "held",
          "posted",
          "all"
        ],
        "description": "default all"
      },
      "supplier_code": {
        "type": "string",
        "description": "optional"
      },
      "po_no": {
        "type": "string",
        "description": "optional"
      }
    },
    "required": []
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "invoices": {
        "type": "array",
        "description": "invoice_no, supplier_name, po_no, gross, status, match, note"
      },
      "by_status": {
        "type": "object",
        "description": "counts"
      }
    }
  },
  "example": {
    "status": "held"
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "policy": {
    "ledgerline_reply_timeout_s": 30,
    "reads_inside": "retried, at most 2 more times"
  },
  "release_notes": {
    "1.0": "12 Nov 2026: Lecture 5 (The Habits): accounts payable and the background agents' watch lists."
  }
}

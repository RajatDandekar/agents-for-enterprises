{
  "name": "register_supplier",
  "title": "Register supplier",
  "category": "Purchasing",
  "description": "Register a NEW supplier. Only after find_supplier shows no existing match. confirm=false previews and checks for duplicates; confirm=true creates it.",
  "writes": true,
  "version": "1.0",
  "services": [
    "sup_search",
    "sup_create"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "registered name"
      },
      "city": {
        "type": "string",
        "description": ""
      },
      "state": {
        "type": "string",
        "description": "Indian state"
      },
      "vat_no": {
        "type": "string",
        "description": "15-character VAT number"
      },
      "confirm": {
        "type": "boolean",
        "description": "false (default) = preview only, nothing is saved; true = commit"
      }
    },
    "required": [
      "name",
      "city",
      "state",
      "vat_no"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "supplier_code": {
        "type": "string",
        "description": "the new code"
      }
    }
  },
  "example": {}
}

{
  "name": "release_purchase_order",
  "title": "Release purchase order",
  "category": "Purchasing",
  "description": "Release an APPROVED purchase order to the supplier; only then does the supplier get it. Returns a receipt with the real status.",
  "writes": true,
  "version": "1.0",
  "services": [
    "po_get",
    "po_release"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "po_no": {
        "type": "string",
        "description": "e.g. PO/2026/01182"
      }
    },
    "required": [
      "po_no"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "po_no": {
        "type": "string",
        "description": ""
      },
      "status": {
        "type": "string",
        "description": "RELEASED to the supplier"
      },
      "sent_to_supplier": {
        "type": "boolean",
        "description": ""
      }
    }
  },
  "example": {
    "po_no": "PO/2026/01182"
  }
}

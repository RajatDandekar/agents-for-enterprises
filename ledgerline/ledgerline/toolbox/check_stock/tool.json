{
  "name": "check_stock",
  "title": "Check stock",
  "category": "Look up",
  "description": "Stock of an item in every warehouse: on hand, allocated, on order, reorder level and days of cover.",
  "writes": false,
  "version": "1.0",
  "services": [
    "itm_get",
    "whs_list",
    "stk_query"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "item_code": {
        "type": "string",
        "description": "Ledgerline item code, e.g. BAT-500"
      }
    },
    "required": [
      "item_code"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "item_code": {
        "type": "string",
        "description": ""
      },
      "warehouses": {
        "type": "array",
        "description": "per warehouse: on_hand, allocated, on_order, free"
      },
      "reorder_level": {
        "type": "integer",
        "description": ""
      },
      "cover_days": {
        "type": "integer",
        "description": "days the free stock lasts at the usual daily use"
      },
      "below_reorder": {
        "type": "boolean",
        "description": ""
      }
    }
  },
  "example": {
    "item_code": "BAT-500"
  }
}

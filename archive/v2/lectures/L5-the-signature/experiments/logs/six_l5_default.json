   "turns": [
    {
     "user": "Shakti Seals in Vadodara has quoted ₹10.40 for the 5-litre silicone gasket. Order 20,000 from them, cost centre PRD-07, need-by 2 November. Their GSTIN is 24AAFCS8812N1Z4.",
     "agent": "Purchase Policy §6.2: Parts that come into contact with food (gaskets, lids, body blanks and any other item marked food-contact in the item master) may be bought only from a supplier holding a valid food-grade certificate on file in Bahi. The certificate must be uploaded and checked before the first order is placed. An expired certificate counts as no certificate.\n\nGasket, silicone, 5 L touches food, and Shakti Seals does not have a valid food-grade certificate in Bahi. We cannot order from them without one on file. Do you have their food-grade certificate, and can you send its reference number and expiry date?",
     "services": [
      "itm_search",
      "itm_search",
      "itm_get",
      "sup_search",
      "sup_search",
      "sup_search",
      "cc_get",
      "bud_check"
     ],
     "writes": []
    },

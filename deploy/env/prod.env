# prod: starts in shadow (deploy/rollout.yaml). Nothing here is secret; secrets live in the "ledgerline-prod" store only.
LEDGER_ENV=prod
LEDGER_MODEL=gemini:gemini-3.8-flash
LEDGER_LLM_MODE=live
LEDGER_TEMPORAL=connect
TEMPORAL_ADDRESS=<namespace>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=ledgerline-prod
LEDGER_FLAGS_FILE=/var/ledgerline/flags.json
# secrets (Modal secret "ledgerline-prod"): GEMINI_API_KEY, LEDGER_ADMIN_TOKEN, TEMPORAL_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY
# Separate keys per environment: a leaked staging key must not be able to write in prod.

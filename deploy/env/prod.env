# prod: starts in shadow (deploy/rollout.yaml). Nothing here is secret; secrets live in the "bahi-prod" store only.
BAHI_ENV=prod
BAHI_MODEL=gemini:gemini-3.8-flash
BAHI_LLM_MODE=live
BAHI_TEMPORAL=connect
TEMPORAL_ADDRESS=<namespace>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=bahi-prod
BAHI_FLAGS_FILE=/var/bahi/flags.json
# secrets (Modal secret "bahi-prod"): GEMINI_API_KEY, BAHI_ADMIN_TOKEN, TEMPORAL_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY
# Separate keys per environment: a leaked staging key must not be able to write in prod.

# staging: the Modal app bahi-agent-staging (deploy/modal_app.py). Same image as prod; real model calls; real timers.
# No secrets in this file: they live in the Modal secret "bahi-staging".
BAHI_ENV=staging
BAHI_MODEL=gemini:gemini-3.8-flash
BAHI_LLM_MODE=live
# No Temporal Cloud yet: an in-process Temporal dev server (WorkflowEnvironment.start_local), real timers.
# Its workflows live in the container's memory, like the sandbox ERP: they are lost when the container stops.
BAHI_TEMPORAL=local
BAHI_APP_DURABLE=1
BAHI_APP_MCP=1
BAHI_FLAGS_FILE=/var/bahi/flags.json
BAHI_STATE_DIR=/var/bahi
# cost controls (public URL): estimated rupees per IST day, and requests per minute that may reach the model
BAHI_DAILY_CAP_INR=250
BAHI_RATE_GLOBAL_PER_MIN=20
BAHI_RATE_USER_PER_MIN=6
# secrets (Modal secret "bahi-staging"): GEMINI_API_KEY, BAHI_ADMIN_TOKEN, OPENROUTER_*, LANGFUSE_*

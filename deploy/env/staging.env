# staging: the Modal app ledgerline-agent-staging (deploy/modal_app.py). Same image as prod; real model calls; real timers.
# No secrets in this file: they live in the Modal secret "ledgerline-staging".
LEDGER_ENV=staging
LEDGER_MODEL=gemini:gemini-3.8-flash
LEDGER_LLM_MODE=live
# No Temporal Cloud yet: an in-process Temporal dev server (WorkflowEnvironment.start_local), real timers.
# Its workflows live in the container's memory, like the sandbox ERP: they are lost when the container stops.
LEDGER_TEMPORAL=local
LEDGER_APP_DURABLE=1
LEDGER_APP_MCP=1
LEDGER_FLAGS_FILE=/var/ledgerline/flags.json
LEDGER_STATE_DIR=/var/ledgerline
# cost controls (public URL): estimated rupees per GMT day, and requests per minute that may reach the model
LEDGER_DAILY_CAP_INR=250
LEDGER_RATE_GLOBAL_PER_MIN=20
LEDGER_RATE_USER_PER_MIN=6
# secrets (Modal secret "ledgerline-staging"): GEMINI_API_KEY, LEDGER_ADMIN_TOKEN, OPENROUTER_*, LANGFUSE_*

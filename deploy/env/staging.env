# staging: same image as prod, its own Bahi tenant, its own Temporal namespace, real timers.
BAHI_ENV=staging
BAHI_MODEL=gemini:gemini-3.8-flash
BAHI_LLM_MODE=live
BAHI_TEMPORAL=connect
TEMPORAL_ADDRESS=<namespace>.tmprl.cloud:7233     # or your self-hosted frontend
TEMPORAL_NAMESPACE=bahi-staging
BAHI_FLAGS_FILE=/var/bahi/flags.json              # on a mounted volume, so a restart keeps the switch where it was
# secrets (Modal secret "bahi-staging"): GEMINI_API_KEY, BAHI_ADMIN_TOKEN, TEMPORAL_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY

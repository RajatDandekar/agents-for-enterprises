# dev: a laptop-free sandbox on Modal or Colab. No secrets in this file: secrets come from the platform.
LEDGER_ENV=dev
LEDGER_MODEL=gemini:gemini-3.8-flash
LEDGER_LLM_MODE=auto              # replay what is recorded, call live only for new requests
LEDGER_TEMPORAL=time_skipping     # Temporal test server; timers skip
LEDGER_FLAGS_FILE=                # empty = flags in memory
# secrets (Modal secret "ledgerline-dev"): GEMINI_API_KEY, LEDGER_ADMIN_TOKEN

# dev: a laptop-free sandbox on Modal or Colab. No secrets in this file: secrets come from the platform.
BAHI_ENV=dev
BAHI_MODEL=gemini:gemini-3.8-flash
BAHI_LLM_MODE=auto              # replay what is recorded, call live only for new requests
BAHI_TEMPORAL=time_skipping     # Temporal test server; timers skip
BAHI_FLAGS_FILE=                # empty = flags in memory
# secrets (Modal secret "bahi-dev"): GEMINI_API_KEY, BAHI_ADMIN_TOKEN

.env
*.env
!deploy/env/*.env
__pycache__/
.ipynb_checkpoints/
.DS_Store
**/qa/
site-dist/

# licensed music (Epidemic Sound): used on the slides site, not redistributed in the repo
lectures/*/flow3d/music/*.mp3

# licensed music for lecture films (Epidemic Sound): site only, never in the public repo
lectures/*/films/music/
lectures/*/films/**/*.wav

# film build renders, audio stems and fonts (regenerable; scripts are committed)
lectures/*/films/build/out/
lectures/*/films/build/audio/
lectures/*/films/build/fonts/
lectures/*/films/build/frames/
lectures/*/films/build/sheets/
lectures/*/films/build/cache/
lectures/*/films/*.mp4
lectures/*/films/*.webm

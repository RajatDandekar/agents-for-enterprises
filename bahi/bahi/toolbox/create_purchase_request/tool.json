{
  "name": "create_purchase_request",
  "title": "Create purchase request",
  "category": "Purchasing",
  "description": "Raise a purchase request (PR): the internal ask to buy something. With confirm=false it previews the estimated value and who must approve; with confirm=true it saves and submits it. Within your limit it is approved at once; above it, it waits for your manager.",
  "writes": true,
  "version": "1.0",
  "services": [
    "pr_search",
    "pr_fetch",
    "usr_get",
    "bud_check",
    "pr_save",
    "pr_submit",
    "pr_get"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "item_code": {
        "type": "string",
        "description": "Bahi item code"
      },
      "quantity": {
        "type": "integer",
        "description": "how many, in the item's unit"
      },
      "cost_centre": {
        "type": "string",
        "description": "who pays, e.g. PRD-07"
      },
      "need_by": {
        "type": "string",
        "description": "date needed, YYYY-MM-DD"
      },
      "confirm": {
        "type": "boolean",
        "description": "false (default) = preview only, nothing is saved; true = commit"
      }
    },
    "required": [
      "item_code",
      "quantity",
      "cost_centre",
      "need_by"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "request_no": {
        "type": "string",
        "description": "e.g. PR/2026/04417"
      },
      "status": {
        "type": "string",
        "description": "WAITING FOR APPROVAL or APPROVED"
      },
      "approver": {
        "type": "string",
        "description": "who must sign"
      },
      "estimated_value": {
        "type": "number",
        "description": "rupees"
      }
    }
  },
  "example": {
    "item_code": "GSK-SIL-05L",
    "quantity": 20000,
    "cost_centre": "PRD-07",
    "need_by": "2026-11-09"
  }
}

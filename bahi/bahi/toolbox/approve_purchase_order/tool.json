{
  "name": "approve_purchase_order",
  "title": "Approve purchase order",
  "category": "Approvals",
  "description": "Approve a purchase order that waits for the signed-in user's signature.",
  "writes": true,
  "version": "1.0",
  "services": [
    "po_approve",
    "po_get"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "po_no": {
        "type": "string",
        "description": "e.g. PO/2026/01182"
      },
      "comment": {
        "type": "string",
        "description": "optional"
      }
    },
    "required": [
      "po_no"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "po_no": {
        "type": "string",
        "description": ""
      },
      "status": {
        "type": "string",
        "description": ""
      }
    }
  },
  "example": {
    "po_no": "PO/2026/01182"
  }
}

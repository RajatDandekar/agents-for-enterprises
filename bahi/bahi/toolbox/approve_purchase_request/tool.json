{
  "name": "approve_purchase_request",
  "title": "Approve purchase request",
  "category": "Approvals",
  "description": "Approve or reject a purchase request that waits for the signed-in user. Only the named approver can do this, never the person who raised it.",
  "writes": true,
  "version": "1.0",
  "services": [
    "pr_approve"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "request_no": {
        "type": "string",
        "description": "e.g. PR/2026/04417"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "reject"
        ],
        "description": "approve or reject"
      },
      "comment": {
        "type": "string",
        "description": "optional note to the requester"
      }
    },
    "required": [
      "request_no",
      "decision"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "true when it worked; false comes with error and next_step"
      },
      "request_no": {
        "type": "string",
        "description": ""
      },
      "status": {
        "type": "string",
        "description": "APPROVED or REJECTED"
      }
    }
  },
  "example": {
    "request_no": "PR/2026/04417",
    "decision": "approve"
  }
}
